# Skopiuj do .env i uzupełnij przed uruchomieniem.

# Sekret chroniący endpointy /api/admin/* - wymyśl długi losowy ciąg,
# np. `openssl rand -hex 32` albo dowolny generator haseł.
ADMIN_SECRET=

# Opcjonalnie - port, na którym nasłuchuje serwer (domyślnie 3000).
PORT=3000

# Odblokowuje POST /api/me/dev-grant (testowe "kup" bez prawdziwej płatności - appka
# pokazuje przycisk tylko w trybie deweloperskim, patrz ShopPage.tsx). NIE ustawiaj
# tego na produkcji - zostaw puste/usunięte.
DEV_LICENSE_GRANTS=

# --- Automatyczna sprzedaż przez LemonSqueezy (opcjonalne, patrz README: sekcja LemonSqueezy) ---

# Signing secret webhooka - ustawiasz go sam przy tworzeniu webhooka w panelu LemonSqueezy
# (Settings -> Webhooks -> Signing secret), wklej dokładnie tę samą wartość tutaj.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Adres Twojego sklepu LemonSqueezy (bez ukośnika na końcu), np. https://twojnick.lemonsqueezy.com
# Zwracany przez /api/catalog, appka z tego buduje link "Kup". Mapowanie variant_id ->
# plugin/pakiet edytuje się w src/catalog.js (nie tutaj).
LEMONSQUEEZY_STORE_URL=

# --- Automatyczna wysyłka klucza mailem przez Resend (opcjonalne) ---
# Bez tych dwóch - klucz i tak zostanie wystawiony po sprzedaży, ale trzeba go
# ręcznie znaleźć w /api/admin/licenses i wysłać klientowi samemu.
# Wysyłka maili - SMTP (preferowane, np. skrzynka noreply@rsmc-network.pl w Hostido):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ...albo Resend (używany tylko, gdy SMTP nie jest ustawiony):
RESEND_API_KEY=
FROM_EMAIL=

# --- Podpisywanie licencji (WYMAGANE - bez tego serwer nie startuje) ---
# Wygeneruj: node deploy/gen-signing-key.mjs (klucz publiczny trafia do LicenseToken.java)
LICENSE_SIGNING_KEY=

# --- Panel wsparcia (/admin) - powiadomienia zespołu (opcjonalne, można oba) ---
# Adresy, na które idzie mail o nowym zgłoszeniu / odpowiedzi klienta (po przecinku).
SUPPORT_NOTIFY_EMAIL=
# Webhook kanału Discorda do powiadomień o zgłoszeniach.
SUPPORT_DISCORD_WEBHOOK=
# Publiczny adres API (do linku w powiadomieniach), domyślnie https://api.rsmc-network.pl
PUBLIC_API_URL=

# Odpowiedzi na maile z noreply@ trafiają na ten adres (polityka prywatności).
REPLY_TO=
# Podpis DKIM wysyłanych maili (klucz poza repo, plik 600).
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_KEY_FILE=
# Powiadomienia o ruchu na stronie (zapisy, ankiety, odwiedziny) na prywatny kanał Discorda.
SITE_DISCORD_WEBHOOK=
# Adres nasłuchu API (domyślnie tylko 127.0.0.1 - z zewnątrz przez Caddy).
HOST=
